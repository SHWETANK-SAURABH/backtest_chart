# Copy to .env. Never commit .env. Credentials are read by the backend only.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

POSTGRES_USER=nifty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nifty_backtester
DATABASE_URL=postgresql+psycopg://nifty:change-me@localhost:5432/nifty_backtester

REDIS_URL=redis://localhost:6379/0
DATA_ROOT=./data
CORS_ORIGINS=["http://localhost:3000"]

# Market data providers: set the one you use. Generate a fresh token before downloading.
# Upstox: from https://account.upstox.com/developer/apps ("Generate"), or the OAuth flow.
UPSTOX_ACCESS_TOKEN=
# Dhan: tokens last 24 hours and need an active Data API plan.
DHAN_ACCESS_TOKEN=

# Browser-visible API base URL. Must never contain credentials.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
